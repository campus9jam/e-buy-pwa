# Database URL — use SQLite for local dev, Turso for production
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"

# Production (Turso — create a free DB at https://turso.tech):
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Admin access (simple shared secret for the prototype)
# Set this to protect the admin API routes in production
ADMIN_SECRET="change-me-in-production"
